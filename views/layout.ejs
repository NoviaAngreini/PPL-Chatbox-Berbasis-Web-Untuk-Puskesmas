<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Puskesmas Digital</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar">
      <div class="navbar-brand">
        <div class="brand-icon">
          <i class="fas fa-stethoscope"></i>
        </div>
        <div class="brand-text">
          <span class="brand-name">Puskesmas Digital Darul Kamal</span>
          <span class="brand-sub">Layanan Kesehatan Terpadu</span>
        </div>
      </div>
      <div class="navbar-right">
        <div class="status-badge">
          <span class="status-dot"></span>
          <span>Online</span>
        </div>
      </div>
      <button class="hamburger" id="hamburger" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
    </nav>

    <div class="app-container">
      <!-- Sidebar -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <p class="sidebar-title">Menu Utama</p>
        </div>
        <nav class="sidebar-nav">
          <a href="/" class="nav-item <%= page === 'chat' ? 'active' : '' %>">
            <i class="fas fa-comment-dots"></i>
            <span>Chatbot</span>
          </a>
          <a
            href="/jadwal"
            class="nav-item <%= page === 'jadwal' ? 'active' : '' %>"
          >
            <i class="fas fa-calendar-alt"></i>
            <span>Jadwal & Dokter</span>
          </a>
          <a
            href="/riwayat"
            class="nav-item <%= page === 'riwayat' ? 'active' : '' %>"
          >
            <i class="fas fa-history"></i>
            <span>Riwayat Chat</span>
          </a>
        </nav>

        <div class="sidebar-footer">
          <div class="info-card">
            <i class="fas fa-phone-alt"></i>
            <div>
              <p class="info-label">Hotline</p>
              <p class="info-value">0813-6022-9095</p>
            </div>
          </div>
          <div class="info-card">
            <i class="fas fa-clock"></i>
            <div>
              <p class="info-label">Jam Operasional</p>
              <p class="info-value">08:00 - 14:00 WIB</p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="main-content"><%- body %></main>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <script src="/js/app.js"></script>
  </body>
</html>
