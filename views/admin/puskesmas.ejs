<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Info Puskesmas - Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>
<nav class="navbar">
  <div class="navbar-brand">
    <div class="brand-icon" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)"><i class="fas fa-shield-alt"></i></div>
    <div class="brand-text">
      <span class="brand-name">Puskesmas Digital <span class="navbar-admin-badge">ADMIN</span></span>
      <span class="brand-sub">Edit Informasi Puskesmas</span>
    </div>
  </div>
  <div class="navbar-right"><div class="status-badge"><span class="status-dot"></span><span>Admin Mode</span></div></div>
  <button class="hamburger" id="hamburger"><i class="fas fa-bars"></i></button>
</nav>

<div class="app-container">
  <%- include('_sidebar') %>

  <main class="main-content">
    <div class="page-content">
      <div class="page-header">
        <h2 class="page-title"><i class="fas fa-cog"></i> Edit Informasi Puskesmas</h2>
        <p class="page-subtitle">Data yang diubah akan langsung tampil di halaman Tentang Puskesmas</p>
      </div>

      <div style="max-width:720px;">
        <div class="tentang-section">
          <h3><i class="fas fa-info-circle"></i> Identitas Puskesmas</h3>
          <div class="form-group"><label class="form-label">Nama Puskesmas</label><input class="form-control" id="pkNama" value="<%= infoPuskesmas.nama %>"/></div>
          <div class="form-group"><label class="form-label">Tagline</label><input class="form-control" id="pkTagline" value="<%= infoPuskesmas.tagline %>"/></div>
          <div class="form-group"><label class="form-label">Alamat</label><input class="form-control" id="pkAlamat" value="<%= infoPuskesmas.alamat %>"/></div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <div class="form-group"><label class="form-label">Telepon</label><input class="form-control" id="pkTelepon" value="<%= infoPuskesmas.telepon %>"/></div>
            <div class="form-group"><label class="form-label">Email</label><input class="form-control" id="pkEmail" value="<%= infoPuskesmas.email %>"/></div>
          </div>
          <div class="form-group"><label class="form-label">Jam Operasional</label><input class="form-control" id="pkJam" value="<%= infoPuskesmas.jamOperasional %>"/></div>
        </div>

        <div class="tentang-section">
          <h3><i class="fas fa-align-left"></i> Deskripsi & Visi</h3>
          <div class="form-group"><label class="form-label">Tentang Kami</label><textarea class="form-control" id="pkTentang" rows="4"><%= infoPuskesmas.tentang %></textarea></div>
          <div class="form-group"><label class="form-label">Visi</label><textarea class="form-control" id="pkVisi" rows="2"><%= infoPuskesmas.visi %></textarea></div>
        </div>

        <div class="tentang-section">
          <h3><i class="fas fa-bullseye"></i> Misi</h3>
          <div class="form-group">
            <label class="form-label">Poin Misi (satu per baris)</label>
            <textarea class="form-control" id="pkMisi" rows="5"><%= infoPuskesmas.misi.join('\n') %></textarea>
          </div>
        </div>

        <div class="tentang-section">
          <h3><i class="fas fa-clinic-medical"></i> Fasilitas</h3>
          <div class="form-group">
            <label class="form-label">Daftar Fasilitas (satu per baris)</label>
            <textarea class="form-control" id="pkFasilitas" rows="5"><%= infoPuskesmas.fasilitas.join('\n') %></textarea>
          </div>
        </div>

        <div style="display:flex;gap:12px;margin-bottom:32px;">
          <button class="btn-primary" onclick="savePuskesmas()"><i class="fas fa-save"></i> Simpan Perubahan</button>
          <a href="/tentang" class="form-control-cancel" style="display:inline-flex;align-items:center;gap:6px;"><i class="fas fa-eye"></i> Lihat Halaman</a>
        </div>
      </div>
    </div>
  </main>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="toast" id="toast"></div>
<script src="/js/app.js"></script>
<script>
async function savePuskesmas() {
  const data = {
    nama: document.getElementById('pkNama').value.trim(),
    tagline: document.getElementById('pkTagline').value.trim(),
    alamat: document.getElementById('pkAlamat').value.trim(),
    telepon: document.getElementById('pkTelepon').value.trim(),
    email: document.getElementById('pkEmail').value.trim(),
    jamOperasional: document.getElementById('pkJam').value.trim(),
    tentang: document.getElementById('pkTentang').value.trim(),
    visi: document.getElementById('pkVisi').value.trim(),
    misi: document.getElementById('pkMisi').value.trim(),
    fasilitas: document.getElementById('pkFasilitas').value.trim()
  };
  const res = await fetch('/admin/puskesmas', {
    method: 'PUT',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify(data)
  });
  if (res.ok) showToast('Informasi puskesmas berhasil disimpan!', 'success');
  else showToast('Gagal menyimpan', 'error');
}
</script>
</body>
</html>
