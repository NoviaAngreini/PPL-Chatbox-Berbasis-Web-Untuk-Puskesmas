<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Ganti Password — Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <style>
    /* ── password strength bar ── */
    .strength-wrap { margin-top: 8px; }
    .strength-bar-track {
      height: 4px; border-radius: 99px;
      background: var(--border);
      overflow: hidden; margin-bottom: 5px;
    }
    .strength-bar-fill {
      height: 100%; border-radius: 99px;
      transition: width .3s, background .3s;
      width: 0%;
    }
    .strength-label { font-size: 11px; font-weight: 600; }

    /* ── rules checklist ── */
    .rules-list {
      list-style: none;
      display: flex; flex-direction: column; gap: 5px;
      margin-top: 10px;
    }
    .rules-list li {
      display: flex; align-items: center; gap: 8px;
      font-size: 12px; color: var(--text-light);
      transition: color .2s;
    }
    .rules-list li.pass { color: #16a34a; }
    .rules-list li i { font-size: 13px; width: 14px; text-align: center; flex-shrink: 0; }
    .rules-list li.pass i::before { content: "\f058"; } /* fa-check-circle */
    .rules-list li:not(.pass) i::before { content: "\f111"; } /* fa-circle (outline) */

    /* ── field match indicator ── */
    .match-hint {
      font-size: 12px; font-weight: 500; margin-top: 6px;
      display: flex; align-items: center; gap: 6px;
    }
    .match-hint.ok   { color: #16a34a; }
    .match-hint.fail { color: #dc2626; }

    /* ── alert boxes ── */
    .alert {
      display: flex; align-items: flex-start; gap: 11px;
      padding: 13px 16px; border-radius: 12px;
      font-size: 13px; font-weight: 500;
      margin-bottom: 22px; line-height: 1.5;
    }
    .alert i { font-size: 16px; flex-shrink: 0; margin-top: 1px; }
    .alert-error   { background: #fef2f2; border: 1px solid #fca5a5; color: #dc2626; }
    .alert-success { background: #f0fdf4; border: 1px solid #86efac; color: #16a34a; }

    /* ── form card ── */
    .pw-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 28px 24px;
      box-shadow: var(--shadow-sm);
      max-width: 480px;
    }
    .pw-card-header {
      display: flex; align-items: center; gap: 13px;
      padding-bottom: 18px; margin-bottom: 22px;
      border-bottom: 1px solid var(--border);
    }
    .pw-card-icon {
      width: 46px; height: 46px; flex-shrink: 0;
      background: linear-gradient(135deg, #7c3aed, #a78bfa);
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      font-size: 20px; color: #fff;
      box-shadow: 0 4px 14px rgba(124,58,237,.35);
    }
    .pw-card-header h3 { font-size: 17px; font-weight: 800; color: var(--text-dark); }
    .pw-card-header p  { font-size: 12px; color: var(--text-light); margin-top: 2px; }

    .form-group { margin-bottom: 18px; }
    .form-label { display: block; font-size: 13px; font-weight: 600; color: var(--text-mid); margin-bottom: 7px; }
    .input-wrap { position: relative; }
    .input-icon  {
      position: absolute; left: 13px; top: 50%;
      transform: translateY(-50%);
      color: var(--text-light); font-size: 14px; pointer-events: none;
    }
    .form-control {
      width: 100%; padding: 11px 42px;
      border: 1.5px solid var(--border);
      border-radius: var(--radius-xs);
      font-size: 14px; font-family: inherit;
      color: var(--text-dark); background: var(--bg);
      outline: none; transition: border-color .18s, box-shadow .18s, background .18s;
    }
    .form-control:focus { border-color: #7c3aed; background: #fff; box-shadow: 0 0 0 3px rgba(124,58,237,.1); }
    .toggle-pw {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: var(--text-light); font-size: 14px; padding: 4px;
      transition: color .15s;
    }
    .toggle-pw:hover { color: var(--text-mid); }

    .btn-save {
      width: 100%; padding: 13px;
      background: linear-gradient(135deg, #7c3aed, #a78bfa);
      color: #fff; border: none; border-radius: var(--radius-xs);
      font-size: 15px; font-weight: 700; font-family: inherit;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center; gap: 9px;
      transition: all .22s;
      box-shadow: 0 4px 16px rgba(124,58,237,.35);
    }
    .btn-save:hover  { transform: translateY(-2px); box-shadow: 0 8px 26px rgba(124,58,237,.45); }
    .btn-save:active { transform: translateY(0); }
    .btn-save:disabled { opacity: .5; pointer-events: none; }

    /* ── info tip ── */
    .tip-box {
      background: #f5f3ff; border: 1px solid #ddd6fe;
      border-radius: 10px; padding: 12px 14px;
      font-size: 12.5px; color: #5b21b6; margin-top: 20px;
      display: flex; gap: 9px; align-items: flex-start; line-height: 1.6;
    }
    .tip-box i { font-size: 14px; flex-shrink: 0; margin-top: 2px; }
  </style>
</head>
<body>

<nav class="navbar">
  <div class="navbar-brand">
    <div class="brand-icon" style="background:linear-gradient(135deg,#7c3aed,#a78bfa)"><i class="fas fa-shield-alt"></i></div>
    <div class="brand-text">
      <span class="brand-name">Puskesmas Digital <span class="navbar-admin-badge">ADMIN</span></span>
      <span class="brand-sub">Ganti Password</span>
    </div>
  </div>
  <div class="navbar-right">
    <div class="status-badge"><span class="status-dot"></span><span>Admin Mode</span></div>
  </div>
  <button class="hamburger" id="hamburger"><i class="fas fa-bars"></i></button>
</nav>

<div class="app-container">
  <%- include('_sidebar') %>

  <main class="main-content">
    <div class="page-content">

      <div class="page-header">
        <h2 class="page-title"><i class="fas fa-key"></i> Ganti Password</h2>
        <p class="page-subtitle">Perbarui kata sandi akun admin Anda</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i><span><%= error %></span></div>
      <% } %>
      <% if (success) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle"></i><span><%= success %></span></div>
      <% } %>

      <div class="pw-card">
        <div class="pw-card-header">
          <div class="pw-card-icon"><i class="fas fa-lock"></i></div>
          <div>
            <h3>Ubah Kata Sandi</h3>
            <p>Akun: <strong><%= adminUser ? adminUser.username : '' %></strong> &mdash; <%= adminUser ? adminUser.nama : '' %></p>
          </div>
        </div>

        <form method="POST" action="/admin/ganti-password" id="pwForm" autocomplete="off">

          <!-- Password lama -->
          <div class="form-group">
            <label class="form-label" for="password_lama">Password Saat Ini</label>
            <div class="input-wrap">
              <i class="fas fa-lock input-icon"></i>
              <input type="password" id="password_lama" name="password_lama"
                class="form-control" placeholder="Masukkan password saat ini" required/>
              <button type="button" class="toggle-pw" data-target="password_lama">
                <i class="fas fa-eye"></i>
              </button>
            </div>
          </div>

          <!-- Password baru -->
          <div class="form-group">
            <label class="form-label" for="password_baru">Password Baru</label>
            <div class="input-wrap">
              <i class="fas fa-key input-icon"></i>
              <input type="password" id="password_baru" name="password_baru"
                class="form-control" placeholder="Buat password baru"
                required oninput="checkStrength(this.value); checkMatch()"/>
              <button type="button" class="toggle-pw" data-target="password_baru">
                <i class="fas fa-eye"></i>
              </button>
            </div>

            <!-- Strength bar -->
            <div class="strength-wrap" id="strengthWrap" style="display:none;">
              <div class="strength-bar-track">
                <div class="strength-bar-fill" id="strengthBar"></div>
              </div>
              <span class="strength-label" id="strengthLabel"></span>
            </div>

            <!-- Rules -->
            <ul class="rules-list" id="rulesList">
              <li id="rule-len" ><i class="fas"></i> Minimal 8 karakter</li>
              <li id="rule-upper"><i class="fas"></i> Mengandung huruf besar</li>
              <li id="rule-lower"><i class="fas"></i> Mengandung huruf kecil</li>
              <li id="rule-num"  ><i class="fas"></i> Mengandung angka</li>
            </ul>
          </div>

          <!-- Konfirmasi -->
          <div class="form-group">
            <label class="form-label" for="password_konfirmasi">Konfirmasi Password Baru</label>
            <div class="input-wrap">
              <i class="fas fa-check-double input-icon"></i>
              <input type="password" id="password_konfirmasi" name="password_konfirmasi"
                class="form-control" placeholder="Ulangi password baru"
                required oninput="checkMatch()"/>
              <button type="button" class="toggle-pw" data-target="password_konfirmasi">
                <i class="fas fa-eye"></i>
              </button>
            </div>
            <div class="match-hint" id="matchHint" style="display:none;"></div>
          </div>

          <button type="submit" class="btn-save" id="submitBtn">
            <i class="fas fa-save"></i> Simpan Password Baru
          </button>
        </form>

        <div class="tip-box">
          <i class="fas fa-info-circle"></i>
          Password baru langsung disimpan ke file <code style="background:#ede9fe;padding:1px 6px;border-radius:4px;font-family:monospace;">data/admins.json</code> dalam bentuk hash terenkripsi. Setelah berhasil, gunakan password baru saat login berikutnya.
        </div>
      </div>

    </div>
  </main>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<div class="toast" id="toast"></div>
<script src="/js/app.js"></script>
<script>
// ── Toggle show/hide password ──────────────────────────────────────────────
document.querySelectorAll('.toggle-pw').forEach(btn => {
  btn.addEventListener('click', function() {
    const inp  = document.getElementById(this.dataset.target);
    const icon = this.querySelector('i');
    if (inp.type === 'password') {
      inp.type = 'text';
      icon.className = 'fas fa-eye-slash';
    } else {
      inp.type = 'password';
      icon.className = 'fas fa-eye';
    }
  });
});

// ── Strength checker ───────────────────────────────────────────────────────
function checkStrength(val) {
  const wrap  = document.getElementById('strengthWrap');
  const bar   = document.getElementById('strengthBar');
  const label = document.getElementById('strengthLabel');

  if (!val) { wrap.style.display = 'none'; return; }
  wrap.style.display = 'block';

  const rules = {
    len:   val.length >= 8,
    upper: /[A-Z]/.test(val),
    lower: /[a-z]/.test(val),
    num:   /[0-9]/.test(val),
    sym:   /[^A-Za-z0-9]/.test(val),
  };

  // Update rule items
  ['len','upper','lower','num'].forEach(r => {
    document.getElementById('rule-' + r).classList.toggle('pass', rules[r]);
  });

  const score = Object.values(rules).filter(Boolean).length;
  const levels = [
    { w: '20%',  bg: '#ef4444', txt: 'Sangat Lemah', color: '#ef4444' },
    { w: '40%',  bg: '#f97316', txt: 'Lemah',        color: '#f97316' },
    { w: '60%',  bg: '#eab308', txt: 'Cukup',        color: '#eab308' },
    { w: '80%',  bg: '#22c55e', txt: 'Kuat',         color: '#22c55e' },
    { w: '100%', bg: '#16a34a', txt: 'Sangat Kuat',  color: '#16a34a' },
  ];
  const lvl = levels[score - 1] || levels[0];
  bar.style.width      = lvl.w;
  bar.style.background = lvl.bg;
  label.textContent    = lvl.txt;
  label.style.color    = lvl.color;

  updateSubmit();
}

// ── Match checker ──────────────────────────────────────────────────────────
function checkMatch() {
  const baru   = document.getElementById('password_baru').value;
  const konfirm = document.getElementById('password_konfirmasi').value;
  const hint   = document.getElementById('matchHint');

  if (!konfirm) { hint.style.display = 'none'; updateSubmit(); return; }

  hint.style.display = 'flex';
  if (baru === konfirm) {
    hint.className = 'match-hint ok';
    hint.innerHTML = '<i class="fas fa-check-circle"></i> Password cocok';
  } else {
    hint.className = 'match-hint fail';
    hint.innerHTML = '<i class="fas fa-times-circle"></i> Password tidak cocok';
  }
  updateSubmit();
}

// ── Enable/disable submit ─────────────────────────────────────────────────
function updateSubmit() {
  const baru    = document.getElementById('password_baru').value;
  const konfirm = document.getElementById('password_konfirmasi').value;
  const lama    = document.getElementById('password_lama').value;
  const allRules = baru.length >= 8 && /[A-Z]/.test(baru) && /[a-z]/.test(baru) && /[0-9]/.test(baru);
  document.getElementById('submitBtn').disabled = !(lama && allRules && baru === konfirm);
}

document.getElementById('password_lama').addEventListener('input', updateSubmit);
</script>
</body>
</html>
