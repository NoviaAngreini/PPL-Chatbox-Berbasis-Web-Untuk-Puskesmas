<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tentang Puskesmas - Puskesmas Digital</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/style.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
</head>
<body>
<nav class="navbar">
  <div class="navbar-brand">
    <div class="brand-icon"><i class="fas fa-stethoscope"></i></div>
    <div class="brand-text">
      <span class="brand-name">Puskesmas Digital Darul Kamal</span>
      <span class="brand-sub">Layanan Kesehatan Terpadu</span>
    </div>
  </div>
  <div class="navbar-right"><div class="status-badge"><span class="status-dot"></span><span>Online</span></div></div>
  <button class="hamburger" id="hamburger"><i class="fas fa-bars"></i></button>
</nav>

<div class="app-container">
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-header"><p class="sidebar-title">Menu Utama</p></div>
    <nav class="sidebar-nav">
      <a href="/chat" class="nav-item"><i class="fas fa-comment-dots"></i><span>Chatbot</span></a>
      <a href="/jadwal" class="nav-item"><i class="fas fa-calendar-alt"></i><span>Jadwal & Dokter</span></a>
      <a href="/riwayat" class="nav-item"><i class="fas fa-history"></i><span>Riwayat Chat</span></a>
      <a href="/informasi" class="nav-item"><i class="fas fa-notes-medical"></i><span>Info Kesehatan</span></a>
      <a href="/tentang" class="nav-item active"><i class="fas fa-hospital"></i><span>Tentang Puskesmas</span></a>
      <div style="height:1px;background:var(--border);margin:8px 12px;"></div>
      <a href="/admin/login" class="nav-item nav-admin"><i class="fas fa-shield-alt"></i><span>Panel Admin</span></a>
    </nav>
    <div class="sidebar-footer">
      <div class="info-card"><i class="fas fa-phone-alt"></i><div><p class="info-label">Hotline</p><p class="info-value"><%= infoPuskesmas.telepon %></p></div></div>
      <div class="info-card"><i class="fas fa-clock"></i><div><p class="info-label">Jam Operasional</p><p class="info-value">08:00 - 14:00 WIB</p></div></div>
    </div>
  </aside>

  <main class="main-content">
    <div class="page-content">
      <div class="page-header">
        <h2 class="page-title"><i class="fas fa-hospital"></i> Tentang Puskesmas</h2>
        <p class="page-subtitle">Informasi lengkap tentang <%= infoPuskesmas.nama %></p>
      </div>

      <div class="tentang-hero">
        <h2><%= infoPuskesmas.nama %></h2>
        <p><%= infoPuskesmas.tagline %></p>
      </div>

      <div class="tentang-section">
        <h3><i class="fas fa-info-circle"></i> Informasi Umum</h3>
        <div class="tentang-grid">
          <div class="tentang-info-item">
            <i class="fas fa-map-marker-alt"></i>
            <div><strong>Alamat</strong><span><%= infoPuskesmas.alamat %></span></div>
          </div>
          <div class="tentang-info-item">
            <i class="fas fa-phone-alt"></i>
            <div><strong>Telepon</strong><span><%= infoPuskesmas.telepon %></span></div>
          </div>
          <div class="tentang-info-item">
            <i class="fas fa-envelope"></i>
            <div><strong>Email</strong><span><%= infoPuskesmas.email %></span></div>
          </div>
          <div class="tentang-info-item">
            <i class="fas fa-clock"></i>
            <div><strong>Jam Operasional</strong><span><%= infoPuskesmas.jamOperasional %></span></div>
          </div>
        </div>
      </div>

      <div class="tentang-section">
        <h3><i class="fas fa-align-left"></i> Tentang Kami</h3>
        <p style="font-size:14px;color:var(--text-mid);line-height:1.7;"><%= infoPuskesmas.tentang %></p>
      </div>

      <div class="tentang-section">
        <h3><i class="fas fa-eye"></i> Visi</h3>
        <p style="font-size:14px;color:var(--text-mid);line-height:1.7;font-style:italic;">"<%= infoPuskesmas.visi %>"</p>
      </div>

      <div class="tentang-section">
        <h3><i class="fas fa-bullseye"></i> Misi</h3>
        <ul class="misi-list">
          <% infoPuskesmas.misi.forEach(function(m) { %>
          <li><%= m %></li>
          <% }); %>
        </ul>
      </div>

      <div class="tentang-section">
        <h3><i class="fas fa-clinic-medical"></i> Fasilitas Layanan</h3>
        <div class="fasilitas-wrap">
          <% infoPuskesmas.fasilitas.forEach(function(f) { %>
          <span class="fasilitas-badge"><i class="fas fa-check-circle" style="color:var(--primary);margin-right:4px;"></i><%= f %></span>
          <% }); %>
        </div>
      </div>
    </div>
  </main>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>
<script src="/js/app.js"></script>
</body>
</html>
