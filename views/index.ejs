<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chatbot - Puskesmas Digital</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
  </head>
  <body>
    <!-- Navbar -->
    <nav class="navbar">
      <div class="navbar-brand">
        <div class="brand-icon">
          <i class="fas fa-stethoscope"></i>
        </div>
        <div class="brand-text">
          <span class="brand-name">E-Maya</span>
          <span class="brand-sub">Puskesmas Digital Darul Kamal Aceh Besar</span>
        </div>
      </div>
      <div class="navbar-right">
        <div class="status-badge">
          <span class="status-dot"></span>
          <span>Online</span>
        </div>
      </div>
      <button class="hamburger" id="hamburger" aria-label="Toggle menu">
        <i class="fas fa-bars"></i>
      </button>
    </nav>

    <div class="app-container">
      <!-- Sidebar -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <p class="sidebar-title">Menu Utama</p>
        </div>
        <nav class="sidebar-nav">
          <a href="/chat" class="nav-item active">
            <i class="fas fa-comment-dots"></i>
            <span>Chatbot</span>
          </a>
          <a href="/jadwal" class="nav-item ">
            <i class="fas fa-calendar-alt"></i>
            <span>Jadwal & Dokter</span>
          </a>
          <a href="/riwayat" class="nav-item ">
            <i class="fas fa-history"></i>
            <span>Riwayat Chat</span>
          </a>
          <a href="/informasi" class="nav-item ">
            <i class="fas fa-notes-medical"></i>
            <span>Info Kesehatan</span>
          </a>
          <a href="/tentang" class="nav-item ">
            <i class="fas fa-hospital"></i>
            <span>Tentang Puskesmas</span>
          </a>
          <div style="height:1px;background:var(--border);margin:8px 12px;"></div>
          <a href="/admin/login" class="nav-item nav-admin">
            <i class="fas fa-shield-alt"></i>
            <span>Panel Admin</span>
          </a>
        </nav>

        <div class="sidebar-footer">
          <div class="info-card">
            <i class="fas fa-phone-alt"></i>
            <div>
              <p class="info-label">Hotline</p>
              <p class="info-value">0813-6022-9095</p>
            </div>
          </div>
          <div class="info-card">
            <i class="fas fa-clock"></i>
            <div>
              <p class="info-label">Jam Operasional</p>
              <p class="info-value">08:00 - 14:00 WIB</p>
            </div>
          </div>
        </div>
      </aside>

      <!-- Main Content: Chat -->
      <main class="main-content">
        <div class="chat-container">
          <div class="chat-header">
            <div class="chat-avatar">
              <i class="fas fa-robot"></i>
            </div>
            <div class="chat-info">
              <h3>Asisten Puskesmas Darul Kamal</h3>
              <span
                class="typing-indicator"
                id="typingIndicator"
                style="display: none"
              >
                <span></span><span></span><span></span>
                sedang mengetik...
              </span>
              <p class="chat-status" id="chatStatus">Siap membantu Anda</p>
            </div>
            <div class="chat-actions">
              <button
                class="btn-action"
                id="btnSaveHistory"
                title="Simpan Riwayat"
              >
                <i class="fas fa-save"></i>
                <span>Simpan</span>
              </button>
              <button
                class="btn-action danger"
                id="btnClearChat"
                title="Hapus Chat"
              >
                <i class="fas fa-trash"></i>
              </button>
            </div>
          </div>

          <div class="chat-messages" id="chatMessages">
            <!-- Welcome bubble -->
            <div class="message-wrapper bot">
              <div class="message-avatar"><i class="fas fa-robot"></i></div>
              <div class="message-bubble bot">
                <p>
                  👋 Halo! Selamat datang di
                  <strong>Chatbot Puskesmas Digital Darul Kamal</strong>.
                </p>
                <p>Saya siap membantu Anda. Anda bisa mengetik:</p>
                <div class="quick-chips">
                  <button class="chip" onclick="sendQuick('jadwal')">
                    📅 Jadwal Poli
                  </button>
                  <button class="chip" onclick="sendQuick('dokter')">
                    👨‍⚕️ Dokter
                  </button>
                  <button class="chip" onclick="sendQuick('pendaftaran')">
                    📋 Pendaftaran
                  </button>
                  <button class="chip" onclick="sendQuick('lokasi')">
                    📍 Lokasi
                  </button>
                </div>
              </div>
              <span class="message-time">Sekarang</span>
            </div>
          </div>

          <div class="chat-input-area">
            <div class="chat-disclaimer">
              <i class="fas fa-info-circle"></i>
              <span>
                Chatbot hanya memberikan informasi kesehatan dasar dan tidak menggantikan konsultasi medis secara langsung.
              </span>
            </div>
            <div class="input-wrapper">
              <input
                type="text"
                id="chatInput"
                class="chat-input"
                placeholder="Ketik pesan Anda..."
                autocomplete="off"
              />
              <button class="btn-send" id="btnSend">
                <i class="fas fa-paper-plane"></i>
              </button>
            </div>
          </div>
        </div>
      </main>
    </div>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <script src="/js/app.js"></script>
    <script src="/js/chat.js"></script>
  </body>
</html>
