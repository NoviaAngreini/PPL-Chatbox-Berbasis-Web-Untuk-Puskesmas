<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>API Docs — Puskesmas Digital</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg:       #0f172a;
      --surface:  #1e293b;
      --surface2: #263248;
      --border:   #334155;
      --text:     #e2e8f0;
      --text-dim: #94a3b8;
      --primary:  #6366f1;
      --green:    #22c55e;
      --yellow:   #eab308;
      --red:      #ef4444;
      --blue:     #3b82f6;
      --orange:   #f97316;
      --cyan:     #06b6d4;
      --radius:   10px;
    }
    body { font-family: "Inter", sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; display: flex; flex-direction: column; }
    code, pre, .mono { font-family: "JetBrains Mono", monospace; }

    /* ── top nav ── */
    .topbar {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 28px;
      height: 56px;
      display: flex; align-items: center; justify-content: space-between;
      position: sticky; top: 0; z-index: 100;
    }
    .topbar-brand { display: flex; align-items: center; gap: 10px; }
    .topbar-icon  { width: 32px; height: 32px; background: linear-gradient(135deg,#6366f1,#a78bfa); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 15px; color: #fff; }
    .topbar-title { font-size: 15px; font-weight: 700; }
    .topbar-badge { font-size: 11px; font-weight: 700; background: #6366f1; color: #fff; padding: 2px 8px; border-radius: 99px; margin-left: 8px; }
    .topbar-links { display: flex; gap: 8px; }
    .topbar-links a { font-size: 13px; color: var(--text-dim); padding: 5px 12px; border-radius: 7px; text-decoration: none; transition: all .15s; border: 1px solid transparent; }
    .topbar-links a:hover { color: var(--text); border-color: var(--border); background: var(--surface2); }

    /* ── layout ── */
    .layout { display: flex; flex: 1; }

    /* sidebar */
    .sidebar {
      width: 240px; flex-shrink: 0;
      background: var(--surface);
      border-right: 1px solid var(--border);
      padding: 20px 0;
      position: sticky; top: 56px;
      height: calc(100vh - 56px);
      overflow-y: auto;
    }
    .sidebar-group { margin-bottom: 6px; }
    .sidebar-group-title {
      font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em;
      color: var(--text-dim); padding: 8px 18px 4px;
    }
    .sidebar-link {
      display: flex; align-items: center; gap: 10px;
      padding: 7px 18px; font-size: 13px; font-weight: 500;
      color: var(--text-dim); text-decoration: none;
      transition: all .15s; border-left: 2px solid transparent;
    }
    .sidebar-link:hover { color: var(--text); background: var(--surface2); }
    .sidebar-link.active { color: #a5b4fc; border-left-color: #6366f1; background: rgba(99,102,241,.08); }
    .method-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .dot-GET    { background: var(--green); }
    .dot-POST   { background: var(--blue); }
    .dot-PUT    { background: var(--yellow); }
    .dot-DELETE { background: var(--red); }

    /* main content */
    .content { flex: 1; padding: 36px 40px; max-width: 900px; }

    /* section */
    .section { margin-bottom: 56px; }
    .section-title {
      font-size: 22px; font-weight: 800;
      color: var(--text); margin-bottom: 6px;
      display: flex; align-items: center; gap: 10px;
    }
    .section-title i { color: #6366f1; font-size: 18px; }
    .section-sub { font-size: 14px; color: var(--text-dim); margin-bottom: 24px; line-height: 1.6; }

    /* base url box */
    .base-url {
      display: flex; align-items: center; gap: 10px;
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 12px 16px;
      margin-bottom: 24px;
    }
    .base-url span { font-size: 12px; color: var(--text-dim); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; }
    .base-url code  { font-size: 14px; color: var(--cyan); flex: 1; }
    .copy-btn {
      background: var(--border); border: none; color: var(--text-dim);
      padding: 4px 10px; border-radius: 6px; font-size: 12px; cursor: pointer;
      font-family: inherit; transition: all .15s;
    }
    .copy-btn:hover { background: var(--primary); color: #fff; }

    /* endpoint card */
    .endpoint-card {
      border: 1px solid var(--border); border-radius: var(--radius);
      margin-bottom: 16px; overflow: hidden;
      transition: border-color .2s;
    }
    .endpoint-card:hover { border-color: #475569; }

    .endpoint-header {
      display: flex; align-items: center; gap: 12px;
      padding: 14px 18px; cursor: pointer;
      background: var(--surface); transition: background .15s;
    }
    .endpoint-header:hover { background: var(--surface2); }

    .method-badge {
      font-size: 11px; font-weight: 800; font-family: "JetBrains Mono", monospace;
      padding: 3px 9px; border-radius: 6px; min-width: 60px; text-align: center; flex-shrink: 0;
    }
    .GET    { background: rgba(34,197,94,.15);  color: #4ade80; border: 1px solid rgba(34,197,94,.3); }
    .POST   { background: rgba(59,130,246,.15); color: #60a5fa; border: 1px solid rgba(59,130,246,.3); }
    .PUT    { background: rgba(234,179,8,.15);  color: #fbbf24; border: 1px solid rgba(234,179,8,.3); }
    .DELETE { background: rgba(239,68,68,.15);  color: #f87171; border: 1px solid rgba(239,68,68,.3); }

    .endpoint-path { font-family: "JetBrains Mono", monospace; font-size: 14px; color: var(--text); flex: 1; }
    .endpoint-desc { font-size: 13px; color: var(--text-dim); }
    .auth-tag {
      font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 99px;
      background: rgba(251,191,36,.12); color: #fbbf24; border: 1px solid rgba(251,191,36,.3);
      display: flex; align-items: center; gap: 5px;
    }
    .chevron { color: var(--text-dim); font-size: 12px; transition: transform .2s; }

    .endpoint-body {
      display: none; border-top: 1px solid var(--border);
      background: #111827;
    }
    .endpoint-body.open { display: block; }

    .ep-section { padding: 16px 18px; border-bottom: 1px solid var(--border); }
    .ep-section:last-child { border-bottom: none; }
    .ep-section-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-dim); margin-bottom: 10px; }

    /* params table */
    .params-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .params-table th { text-align: left; padding: 7px 10px; color: var(--text-dim); font-size: 11px; font-weight: 700; text-transform: uppercase; border-bottom: 1px solid var(--border); }
    .params-table td { padding: 8px 10px; border-bottom: 1px solid rgba(51,65,85,.5); vertical-align: top; }
    .params-table tr:last-child td { border-bottom: none; }
    .param-name { color: #93c5fd; font-family: "JetBrains Mono", monospace; font-size: 12px; }
    .param-type { color: #a78bfa; font-family: "JetBrains Mono", monospace; font-size: 12px; }
    .param-req  { color: #f87171; font-size: 11px; font-weight: 700; }
    .param-opt  { color: var(--text-dim); font-size: 11px; }

    /* code block */
    .code-block {
      background: #0d1117; border-radius: 8px;
      padding: 14px 16px; font-size: 13px; line-height: 1.65;
      overflow-x: auto; color: #e6edf3;
      border: 1px solid var(--border);
    }
    .json-key    { color: #79c0ff; }
    .json-str    { color: #a5d6ff; }
    .json-num    { color: #ffa657; }
    .json-bool   { color: #ff7b72; }
    .json-null   { color: #8b949e; }
    .json-punct  { color: #8b949e; }

    /* try it panel */
    .try-panel { padding: 18px; background: #0d1117; border-top: 1px solid var(--border); }
    .try-title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-dim); margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
    .try-title i { color: var(--primary); }
    .try-row { display: flex; gap: 8px; margin-bottom: 10px; align-items: flex-start; }
    .try-label { font-size: 12px; font-weight: 600; color: var(--text-dim); min-width: 90px; padding-top: 9px; }
    .try-input {
      flex: 1; background: var(--surface2); border: 1px solid var(--border);
      border-radius: 7px; padding: 8px 12px;
      color: var(--text); font-size: 13px; font-family: "JetBrains Mono", monospace;
      outline: none; transition: border-color .15s;
    }
    .try-input:focus { border-color: var(--primary); }
    textarea.try-input { resize: vertical; min-height: 80px; }
    .try-btn {
      background: var(--primary); color: #fff; border: none;
      padding: 9px 18px; border-radius: 7px;
      font-size: 13px; font-weight: 700; font-family: inherit;
      cursor: pointer; display: flex; align-items: center; gap: 7px;
      transition: all .18s;
    }
    .try-btn:hover { background: #4f46e5; transform: translateY(-1px); }
    .try-response {
      background: #0d1117; border: 1px solid var(--border); border-radius: 8px;
      padding: 14px; margin-top: 10px; font-size: 13px; line-height: 1.6;
      font-family: "JetBrains Mono", monospace; color: #e6edf3;
      white-space: pre-wrap; display: none; max-height: 300px; overflow-y: auto;
    }
    .try-response.visible { display: block; }
    .res-ok   { border-color: rgba(34,197,94,.4); }
    .res-fail { border-color: rgba(239,68,68,.4); }
    .res-status { font-size: 12px; font-weight: 700; margin-bottom: 8px; }
    .res-status.ok   { color: #4ade80; }
    .res-status.fail { color: #f87171; }

    /* token helper */
    .token-bar {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 14px 18px;
      margin-bottom: 24px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .token-bar label { font-size: 12px; font-weight: 700; color: var(--text-dim); text-transform: uppercase; letter-spacing: .07em; white-space: nowrap; }
    .token-bar input {
      flex: 1; background: var(--bg); border: 1px solid var(--border);
      border-radius: 7px; padding: 8px 12px;
      color: var(--text); font-size: 13px; font-family: "JetBrains Mono", monospace;
      outline: none; min-width: 200px;
    }
    .token-bar input:focus { border-color: var(--primary); }
    .token-bar .token-save { background: var(--primary); color: #fff; border: none; padding: 8px 14px; border-radius: 7px; font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer; white-space: nowrap; }

    /* overview cards */
    .overview-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; margin-bottom: 28px; }
    .ov-card { background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius); padding: 16px; }
    .ov-card-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--text-dim); margin-bottom: 8px; }
    .ov-card-val { font-size: 20px; font-weight: 800; color: var(--text); }
    .ov-card-sub { font-size: 12px; color: var(--text-dim); margin-top: 3px; }

    @media (max-width: 768px) {
      .sidebar { display: none; }
      .content { padding: 20px; }
    }
  </style>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <div class="topbar-brand">
    <div class="topbar-icon"><i class="fas fa-code"></i></div>
    <span class="topbar-title">Puskesmas Digital Darul Kamal <span class="topbar-badge">API v1</span></span>
  </div>
  <div class="topbar-links">
    <a href="/"><i class="fas fa-home"></i> Website</a>
    <a href="/admin"><i class="fas fa-shield-alt"></i> Admin</a>
  </div>
</div>

<div class="layout">

  <!-- SIDEBAR -->
  <nav class="sidebar">
    <div class="sidebar-group">
      <div class="sidebar-group-title">Mulai</div>
      <a href="#overview"  class="sidebar-link active"><i class="fas fa-book-open" style="width:14px;color:#6366f1;"></i> Overview</a>
      <a href="#auth-login" class="sidebar-link"><i class="fas fa-key" style="width:14px;color:#fbbf24;"></i> Autentikasi</a>
    </div>
    <div class="sidebar-group">
      <div class="sidebar-group-title">Jadwal</div>
      <a href="#jadwal-list"   class="sidebar-link"><span class="method-dot dot-GET"></span> GET semua jadwal</a>
      <a href="#jadwal-detail" class="sidebar-link"><span class="method-dot dot-GET"></span> GET jadwal by ID</a>
      <a href="#jadwal-create" class="sidebar-link"><span class="method-dot dot-POST"></span> POST jadwal</a>
      <a href="#jadwal-update" class="sidebar-link"><span class="method-dot dot-PUT"></span> PUT jadwal</a>
      <a href="#jadwal-delete" class="sidebar-link"><span class="method-dot dot-DELETE"></span> DELETE jadwal</a>
    </div>
    <div class="sidebar-group">
      <div class="sidebar-group-title">Dokter</div>
      <a href="#dokter-list"   class="sidebar-link"><span class="method-dot dot-GET"></span> GET semua dokter</a>
      <a href="#dokter-detail" class="sidebar-link"><span class="method-dot dot-GET"></span> GET dokter by ID</a>
      <a href="#dokter-create" class="sidebar-link"><span class="method-dot dot-POST"></span> POST dokter</a>
      <a href="#dokter-update" class="sidebar-link"><span class="method-dot dot-PUT"></span> PUT dokter</a>
      <a href="#dokter-delete" class="sidebar-link"><span class="method-dot dot-DELETE"></span> DELETE dokter</a>
    </div>
    <div class="sidebar-group">
      <div class="sidebar-group-title">Informasi Kesehatan</div>
      <a href="#info-list"   class="sidebar-link"><span class="method-dot dot-GET"></span> GET semua info</a>
      <a href="#info-detail" class="sidebar-link"><span class="method-dot dot-GET"></span> GET info by ID</a>
      <a href="#info-create" class="sidebar-link"><span class="method-dot dot-POST"></span> POST info</a>
      <a href="#info-update" class="sidebar-link"><span class="method-dot dot-PUT"></span> PUT info</a>
      <a href="#info-delete" class="sidebar-link"><span class="method-dot dot-DELETE"></span> DELETE info</a>
    </div>
    <div class="sidebar-group">
      <div class="sidebar-group-title">Riwayat Chat</div>
      <a href="#riwayat-list"   class="sidebar-link"><span class="method-dot dot-GET"></span> GET riwayat</a>
      <a href="#riwayat-detail" class="sidebar-link"><span class="method-dot dot-GET"></span> GET riwayat by ID</a>
      <a href="#riwayat-delete" class="sidebar-link"><span class="method-dot dot-DELETE"></span> DELETE riwayat</a>
    </div>
    <div class="sidebar-group">
      <div class="sidebar-group-title">Puskesmas</div>
      <a href="#pkm-get" class="sidebar-link"><span class="method-dot dot-GET"></span> GET info puskesmas</a>
      <a href="#pkm-put" class="sidebar-link"><span class="method-dot dot-PUT"></span> PUT info puskesmas</a>
    </div>
  </nav>

  <!-- CONTENT -->
  <main class="content">

    <!-- OVERVIEW -->
    <div class="section" id="overview">
      <h1 class="section-title"><i class="fas fa-book-open"></i> Puskesmas Digital REST API</h1>
      <p class="section-sub">API RESTful untuk mengakses dan mengelola data Puskesmas Digital. Endpoint publik bisa diakses langsung, endpoint admin membutuhkan JWT Token.</p>

      <div class="overview-grid">
        <div class="ov-card"><div class="ov-card-title">Base URL</div><div class="ov-card-val" style="font-size:14px;font-family:monospace;">/api/v1</div><div class="ov-card-sub">Prefix semua endpoint</div></div>
        <div class="ov-card"><div class="ov-card-title">Format</div><div class="ov-card-val">JSON</div><div class="ov-card-sub">Request & Response</div></div>
        <div class="ov-card"><div class="ov-card-title">Auth</div><div class="ov-card-val">JWT</div><div class="ov-card-sub">Bearer Token, 8 jam</div></div>
        <div class="ov-card"><div class="ov-card-title">Versi</div><div class="ov-card-val">v1</div><div class="ov-card-sub">Stabil</div></div>
      </div>

      <div class="base-url">
        <span>Base URL</span>
        <code id="baseUrl">http://localhost:3000/api/v1</code>
        <button class="copy-btn" onclick="copyBase()"><i class="fas fa-copy"></i> Salin</button>
      </div>

      <!-- Token Manager -->
      <div class="token-bar">
        <label><i class="fas fa-key"></i> JWT Token</label>
        <input type="text" id="globalToken" placeholder="Paste token di sini untuk dicoba di semua endpoint..." />
        <button class="token-save" onclick="saveToken()"><i class="fas fa-check"></i> Simpan</button>
      </div>

      <p style="font-size:13px;color:var(--text-dim);margin-bottom:8px;"><strong style="color:var(--text);">Format response sukses:</strong></p>
      <div class="code-block">
<span class="json-punct">{</span>
  <span class="json-key">"success"</span><span class="json-punct">:</span> <span class="json-bool">true</span><span class="json-punct">,</span>
  <span class="json-key">"total"</span><span class="json-punct">:</span> <span class="json-num">6</span><span class="json-punct">,</span>           <span style="color:#555">// opsional, hanya untuk list</span>
  <span class="json-key">"data"</span><span class="json-punct">:</span> <span class="json-punct">{ ... }</span>
<span class="json-punct">}</span>
      </div>
      <br/>
      <p style="font-size:13px;color:var(--text-dim);margin-bottom:8px;"><strong style="color:var(--text);">Format response error:</strong></p>
      <div class="code-block">
<span class="json-punct">{</span>
  <span class="json-key">"success"</span><span class="json-punct">:</span> <span class="json-bool">false</span><span class="json-punct">,</span>
  <span class="json-key">"message"</span><span class="json-punct">:</span> <span class="json-str">"Pesan error di sini"</span>
<span class="json-punct">}</span>
      </div>
    </div>

    <!-- AUTH -->
    <div class="section" id="auth-login">
      <h2 class="section-title"><i class="fas fa-key"></i> Autentikasi</h2>
      <p class="section-sub">Login untuk mendapatkan JWT Token. Sertakan token di header <code style="color:#93c5fd;">Authorization: Bearer &lt;token&gt;</code> untuk semua endpoint admin.</p>

      <%- include('api-docs/_endpoint', {
        id: 'auth-login',
        method: 'POST', path: '/api/v1/auth/login',
        desc: 'Login dan dapatkan JWT Token',
        auth: false,
        params: [
          { name: 'username', type: 'string', req: true,  desc: 'Username admin' },
          { name: 'password', type: 'string', req: true,  desc: 'Password admin' },
        ],
        query: [],
        exampleReq: '{\n  "username": "admin",\n  "password": "Admin@Puskesmas2025"\n}',
        exampleRes: '{\n  "success": true,\n  "message": "Login berhasil.",\n  "data": {\n    "token": "eyJhbGciOiJIUzI1NiIs...",\n    "expires_in": "8h",\n    "user": {\n      "id": 1,\n      "username": "admin",\n      "nama": "Administrator",\n      "role": "admin"\n    }\n  }\n}',
        tryUrl: '/api/v1/auth/login',
        tryMethod: 'POST',
        tryBody: '{\n  "username": "admin",\n  "password": "Admin@Puskesmas2025"\n}',
        showTokenSave: true
      }) %>
    </div>

    <!-- JADWAL -->
    <div class="section">
      <h2 class="section-title"><i class="fas fa-calendar-check"></i> Jadwal Poli</h2>
      <p class="section-sub">Kelola jadwal poli puskesmas. GET bersifat publik, POST/PUT/DELETE memerlukan JWT.</p>

      <%- include('api-docs/_endpoint', { id:'jadwal-list', method:'GET', path:'/api/v1/jadwal', desc:'Ambil semua jadwal poli', auth:false,
        params:[], query:[{name:'status',desc:'Filter: Buka / Libur'},{name:'poli',desc:'Filter nama poli (partial match)'}],
        exampleReq:'', exampleRes:'{\n  "success": true,\n  "total": 6,\n  "data": [\n    { "id": 1, "poli": "Poli Umum", "hari": "Senin - Sabtu", "jam": "08:00 - 12:00", "dokter": "dr. Ahmad Santoso", "status": "Buka" }\n  ]\n}',
        tryUrl:'/api/v1/jadwal', tryMethod:'GET', tryBody:'', showTokenSave:false }) %>

      <%- include('api-docs/_endpoint', { id:'jadwal-detail', method:'GET', path:'/api/v1/jadwal/:id', desc:'Ambil jadwal berdasarkan ID', auth:false,
        params:[{name:':id',type:'number',req:true,desc:'ID jadwal'}], query:[],
        exampleReq:'', exampleRes:'{\n  "success": true,\n  "data": { "id": 1, "poli": "Poli Umum", "hari": "Senin - Sabtu", "jam": "08:00 - 12:00", "dokter": "dr. Ahmad Santoso", "status": "Buka" }\n}',
        tryUrl:'/api/v1/jadwal/1', tryMethod:'GET', tryBody:'', showTokenSave:false }) %>

      <%- include('api-docs/_endpoint', { id:'jadwal-create', method:'POST', path:'/api/v1/jadwal', desc:'Tambah jadwal baru', auth:true,
        params:[{name:'poli',type:'string',req:true,desc:'Nama poli'},{name:'hari',type:'string',req:true,desc:'Hari operasional'},{name:'jam',type:'string',req:true,desc:'Jam operasional'},{name:'dokter',type:'string',req:true,desc:'Nama dokter'},{name:'status',type:'string',req:false,desc:'Buka / Libur (default: Buka)'}], query:[],
        exampleReq:'{\n  "poli": "Poli Kulit",\n  "hari": "Senin, Rabu",\n  "jam": "09:00 - 12:00",\n  "dokter": "dr. Budi Santoso",\n  "status": "Buka"\n}',
        exampleRes:'{\n  "success": true,\n  "message": "Jadwal berhasil ditambahkan.",\n  "data": { "id": 7, "poli": "Poli Kulit", ... }\n}',
        tryUrl:'/api/v1/jadwal', tryMethod:'POST', tryBody:'{\n  "poli": "Poli Kulit",\n  "hari": "Senin, Rabu",\n  "jam": "09:00 - 12:00",\n  "dokter": "dr. Budi Santoso",\n  "status": "Buka"\n}', showTokenSave:false }) %>

