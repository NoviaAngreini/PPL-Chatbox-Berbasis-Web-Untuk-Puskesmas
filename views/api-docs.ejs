<script>
let globalToken = '';

function saveToken() {
  globalToken = document.getElementById('globalToken').value.trim();
  if (globalToken) showToast('Token disimpan! Siap digunakan di semua endpoint.');
}

function copyBase() {
  navigator.clipboard.writeText(document.getElementById('baseUrl').textContent);
  showToast('Base URL disalin!');
}

function showToast(msg) {
  const t = document.createElement('div');
  t.textContent = msg;
  t.style.cssText = 'position:fixed;bottom:24px;right:24px;background:#6366f1;color:#fff;padding:10px 18px;border-radius:10px;font-size:13px;font-weight:600;z-index:999;box-shadow:0 8px 24px rgba(99,102,241,.4);animation:fadeIn .2s ease';
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 2500);
}

function toggleEndpoint(id) {
  const body = document.getElementById('body-' + id);
  const chev = document.getElementById('chev-' + id);
  const isOpen = body.classList.contains('open');
  body.classList.toggle('open');
  chev.style.transform = isOpen ? '' : 'rotate(180deg)';
}

async function tryEndpoint(id, method, url, needsAuth) {
  const bodyEl  = document.getElementById('try-body-' + id);
  const resEl   = document.getElementById('try-res-' + id);
  const urlEl   = document.getElementById('try-url-' + id);
  const token   = document.getElementById('globalToken').value.trim() || globalToken;
  const reqUrl  = urlEl ? urlEl.value.trim() : url;

  const headers = { 'Content-Type': 'application/json' };
  if (needsAuth && token) headers['Authorization'] = 'Bearer ' + token;

  resEl.className = 'try-response visible';
  resEl.innerHTML = '<div class="res-status">⏳ Mengirim request...</div>';

  try {
    const opts = { method, headers };
    if (bodyEl && bodyEl.value.trim() && method !== 'GET' && method !== 'DELETE') {
      opts.body = bodyEl.value.trim();
    }
    const r    = await fetch(reqUrl, opts);
    const json = await r.json();
    const ok   = r.ok;

    // auto-save token jika login berhasil
    if (id === 'auth-login' && json.success && json.data?.token) {
      document.getElementById('globalToken').value = json.data.token;
      globalToken = json.data.token;
    }

    resEl.className = 'try-response visible ' + (ok ? 'res-ok' : 'res-fail');
    resEl.innerHTML =
      '<div class="res-status ' + (ok ? 'ok' : 'fail') + '">HTTP ' + r.status + ' ' + (ok ? '✓' : '✗') + '</div>' +
      syntaxHighlight(JSON.stringify(json, null, 2));
  } catch (e) {
    resEl.className = 'try-response visible res-fail';
    resEl.innerHTML = '<div class="res-status fail">Error</div>' + e.message;
  }
}

function syntaxHighlight(json) {
  return json.replace(/("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g, function(m) {
    if (/^"/.test(m)) {
      if (/:$/.test(m)) return '<span class="json-key">' + m + '</span>';
      return '<span class="json-str">' + m + '</span>';
    }
    if (/true|false/.test(m)) return '<span class="json-bool">' + m + '</span>';
    if (/null/.test(m))       return '<span class="json-null">' + m + '</span>';
    return '<span class="json-num">' + m + '</span>';
  });
}
</script>
